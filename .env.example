DATABASE_URL=mongodb://127.0.0.1:27017/homemade
# Production requires a unique, randomly generated value of at least 32 bytes.
SESSION_SECRET=replace-me
# Configure all three values for each provider you want to enable.
# GOOGLE_CLIENT_ID=
# GOOGLE_SECRET=
# GOOGLE_CALLBACK=http://localhost:3000/auth/google/oauth2callback
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GITHUB_CALLBACK=http://localhost:3000/auth/github/callback
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# MICROSOFT_CALLBACK=http://localhost:3000/auth/microsoft/callback

# Local development only. Allows the API to return sign-up and magic links directly.
AUTH_DEBUG_LINKS=false

# Prefer the AWS SDK credential chain; if needed, set test credentials locally.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET=
# Storage adapter used for new image uploads and portable media references.
MEDIA_PROVIDER=s3

PORT=3000
# Set only when deploying behind a known number of trusted reverse proxy hops.
# TRUST_PROXY_HOPS=1
FRONTEND_URL=http://localhost:3001
CLIENT_ORIGIN=http://localhost:3001
API_BASE_URL=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000
