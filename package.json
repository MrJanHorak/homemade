{
  "name": "homemade",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A social media, sharing site for makers and creators",
  "main": "server.js",
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "start": "node ./bin/www.js",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "nodemon ./bin/www.js",
    "dev:client": "npm run dev --workspace frontend",
    "build:client": "npm run build --workspace frontend",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MrJanHorak/homemade.git"
  },
  "keywords": [
    "social",
    "sharing",
    "makers",
    "creators"
  ],
  "author": "Jan Horak",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/MrJanHorak/homemade/issues"
  },
  "homepage": "https://github.com/MrJanHorak/homemade#readme",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.462.0",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "ejs": "^3.1.9",
    "express": "^4.18.2",
    "express-session": "^1.17.3",
    "express-socket.io-session": "^1.3.5",
    "http-errors": "^2.0.0",
    "method-override": "^3.0.0",
    "mongoose": "^8.0.1",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "nodemon": "^3.0.1",
    "passport": "^0.6.0",
    "passport-apple": "^2.0.2",
    "passport-github2": "^0.1.12",
    "passport-google-oauth": "^2.0.0",
    "passport-microsoft": "^2.1.0",
    "sanitize-html": "^2.17.1",
    "socket.io": "^4.7.2",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
